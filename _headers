/social-security-couples/
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-B7O7FgjWvCvbYgqSyXNG2RlK4+T8h0B3zLA7E93xuXM='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

