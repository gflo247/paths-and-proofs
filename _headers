# Paths and Proofs — security headers for Cloudflare Pages
# More-specific paths override the same header from broader paths.
#
# script-src strategy:
#   Landing / SS / Life Insurance: static inline scripts → sha256 hashes, no unsafe-inline
#   Relocation / Medicare: generated data blob inline scripts → unsafe-inline (hashes would
#     go stale on every npm run gen; wire gen-headers into npm run gen to harden later)
#   Roth: 93 inline event handlers → unsafe-inline (refactor required to remove)

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Landing page — two static inline scripts (lock drawer + theme toggle)
# Note: /index.html is intentionally absent — CF Pages 301-redirects it to /,
# so the document request always lands here and gets the hash-locked rule.
/
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-Qg20vlzzblJw/WEqDVwkTw191kNa7JXud/c5CPZu6O4=' 'sha256-cTDVdBCHnalVGbV1N9IqXaoBvNTxGffnZ+1eARKVRuk='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

